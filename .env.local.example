# ─────────────────────────────────────────────────────────────
# Supabase (Project Settings → API 에서 복사)
# ─────────────────────────────────────────────────────────────
# 브라우저에 노출되어도 되는 값 (실시간 협업 채널용)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# 서버에서만 사용 (절대 NEXT_PUBLIC_ 접두어 금지!)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ─────────────────────────────────────────────────────────────
# OpenRouter (https://openrouter.ai/keys)
# ─────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=google/gemini-2.0-flash-001
OPENROUTER_SITE_URL=http://localhost:3000
# HTTP 헤더는 영문(ASCII)만 사용 가능합니다.
OPENROUTER_APP_NAME=Social Participation Workspace

# ─────────────────────────────────────────────────────────────
# 세션 서명 및 교사 관리자 비밀번호
# ─────────────────────────────────────────────────────────────
# 임의의 긴 랜덤 문자열 (예: openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-long-random-string

# 교사 대시보드 접근 비밀번호 (아래 문서의 해시 생성 방법 참고)
# bcrypt 해시를 넣으면 우선 사용되고, 없으면 평문(TEACHER_PASSWORD)을 사용합니다.
TEACHER_PASSWORD_HASH=
TEACHER_PASSWORD=teacher1234
